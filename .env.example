# Server port (default: 7583)
PORT=7583

# File TTL in seconds (default: 86400 = 24 hours)
TTL_SECONDS=86400

# Cleanup interval in minutes (how often to check for expired files, default: 60 = 1 hour)
CLEANUP_INTERVAL_MINUTES=60

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
